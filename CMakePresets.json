{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BIN_FOLDER": "${sourceDir}/bin/${presetName}"
            }
        },

        {"name": "debug",   "hidden": true, "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
        {"name": "release", "hidden": true, "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},

        {"name": "static",  "hidden": true, "cacheVariables": {"GKIT_STATIC_BUILD": true}},
        {"name": "shared",  "hidden": true, "cacheVariables": {"GKIT_SHARED_BUILD": true}},

        {"name": "test",    "hidden": true, "cacheVariables": {"GKIT_TEST_BUILD": true}},
        {"name": "notest",  "hidden": true, "cacheVariables": {"GKIT_TEST_BUILD": false}},

        {"name": "c_abi",   "hidden": true, "cacheVariables": {"GKIT_ENABLE_CABI": true}},
        {"name": "noabi",   "hidden": true, "cacheVariables": {"GKIT_ENABLE_CABI": false}},

        {"name": "gcc",  "hidden": true, "cacheVariables": {"CMAKE_C_COMPILER": "gcc",   "CMAKE_CXX_COMPILER": "g++"}},
        {"name": "llvm", "hidden": true, "cacheVariables": {"CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++"}},
        {"name": "msvc", "hidden": true, "cacheVariables": {"CMAKE_C_COMPILER": "cl",    "CMAKE_CXX_COMPILER": "cl", "CMAKE_CXX_LINKER": "link.exe"}},

        { "name": "x86_64-gcc-debug",           "inherits": ["common", "debug", "gcc",  "static", "shared", "test"]},
        { "name": "x86_64-llvm-debug",          "inherits": ["common", "debug", "llvm", "static", "shared", "test"]},
        { "name": "x86_64-gcc-debug-notest",    "inherits": ["common", "debug", "gcc",  "static", "shared", "notest"]},
        { "name": "x86_64-llvm-debug-notest",   "inherits": ["common", "debug", "llvm", "static", "shared", "notest"]},
        { "name": "windows-x86_64-msvc-debug",          "inherits": ["common", "debug", "static", "shared", "msvc", "test"] },
        { "name": "windows-x86_64-msvc-debug-notest",   "inherits": ["common", "debug", "static", "shared", "msvc", "notest"] }
    ]
}